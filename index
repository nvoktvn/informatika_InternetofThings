      paint();
    });
    b.addEventListener('dragstart',function(e){
      if(locked){e.preventDefault();return;}
      try{e.dataTransfer.setData('text/plain',String(i));e.dataTransfer.effectAllowed='move';}catch(_){}
      sel=-1;
    });
    return b;
  });
  function move(i,bi){at[i]=bi;sel=-1;paint();}
  function dropOn(bi,node){
    node.addEventListener('dragover',function(e){if(locked)return;e.preventDefault();if(bi>=0)node.classList.add('over');});
    node.addEventListener('dragleave',function(){node.classList.remove('over');});
    node.addEventListener('drop',function(e){
      e.preventDefault();node.classList.remove('over');
      if(locked) return;
      var i=parseInt(e.dataTransfer.getData('text/plain'),10);
      if(!isNaN(i)) move(i,bi);
    });
  }
  var bins=el('div',{class:'bins'});
  q.bins.forEach(function(n,bi){
    var slot=el('div',{class:'slot'});
    var w=el('div',{class:'bin'},el('div',{class:'binname'},n),slot);
    w.addEventListener('click',function(e){
      if(locked||sel<0||e.target.closest('.dcard')) return;
      move(sel,bi);
    });
    dropOn(bi,w);
    slots.push(slot);binEls.push(w);bins.append(w);
  });
  dropOn(-1,pool);
  var btn=el('button',{class:'primary',type:'button'},'Periksa jawaban');
  btn.addEventListener('click',function(){
    locked=true;
    var ok=true;
    cards.forEach(function(c,i){
      var good=at[i]===q.cards[i][1];
      if(!good) ok=false;
      c.classList.remove('sel');c.classList.add(good?'ok':'bad');c.disabled=true;c.draggable=false;
    });
    btn.remove();
    finish(ok, ok?q.why:'Kunci: '+q.cards.map(function(c){return c[0]+' → '+q.bins[c[1]];}).join('; ')+'.');
  });
  function paint(){
    var inPool=[];
    slots.forEach(function(s){s.replaceChildren();});
    q.order.forEach(function(i){
      cards[i].classList.toggle('sel',sel===i);
      if(at[i]<0) inPool.push(cards[i]); else slots[at[i]].append(cards[i]);
    });
    pool.replaceChildren.apply(pool,inPool);
    btn.disabled=at.indexOf(-1)>=0;
  }
  body.append(pool,bins,btn);
  paint();
};
BUILD.match=function(q,body,finish){
  var opts=q.shuf.map(function(i){return q.pairs[i][1];});
  var rows=q.pairs.map(function(p,i){
    var id=q.id+'-'+i;
    var s=el('select',{id:id});
    s.append(el('option',{value:''},'Pilih penjelasan…'));
    opts.forEach(function(o){s.append(el('option',{value:o},o));});
    return {sel:s,row:el('div',{class:'mrow'},el('label',{class:'term','for':id},p[0]),s)};
  });
  var btn=el('button',{class:'primary',type:'button'},'Periksa jawaban');
  btn.addEventListener('click',function(){
    var ok=true;
    rows.forEach(function(r,i){
      var good=r.sel.value===q.pairs[i][1];
      if(!good) ok=false;
      r.row.classList.add(good?'ok':'bad');r.sel.disabled=true;
    });
    btn.remove();
    finish(ok, ok?q.why:'Kunci: '+q.pairs.map(function(p){return p[0]+' = '+p[1];}).join('; ')+'.');
  });
  body.append(el('div',{},rows.map(function(r){return r.row;})),btn);
};
BUILD.order=function(q,body,finish){
  var seq=q.start.slice(), locked=false;
  var list=el('ol',{class:'ord'});
  var btn=el('button',{class:'primary',type:'button'},'Periksa urutan');
  function swap(a,b){var t=seq[a];seq[a]=seq[b];seq[b]=t;paint();}
  function paint(){
    list.replaceChildren.apply(list,seq.map(function(idx,pos){
      var up=el('button',{type:'button','aria-label':'Naikkan langkah'},'↑');
      var dn=el('button',{type:'button','aria-label':'Turunkan langkah'},'↓');
      up.disabled=locked||pos===0; dn.disabled=locked||pos===seq.length-1;
      up.addEventListener('click',function(){swap(pos,pos-1);});
      dn.addEventListener('click',function(){swap(pos,pos+1);});
      var li=el('li',{class:'oitem'},el('span',{class:'ot'},q.items[idx]),el('span',{class:'ob'},up,dn));
      if(locked) li.classList.add(idx===pos?'ok':'bad');
      return li;
    }));
  }
  btn.addEventListener('click',function(){
    locked=true;
    var ok=seq.every(function(idx,pos){return idx===pos;});
    paint();btn.remove();
    finish(ok, ok?q.why:'Urutan yang benar: '+q.items.map(function(t,i){return (i+1)+'. '+t;}).join(' ')+' '+q.why);
  });
  body.append(list,btn);
  paint();
};

function qcard(q,n){
  var art=el('article',{class:'q',id:q.id});
  var body=el('div',{});
  art.append(el('div',{class:'qhead'},el('span',{class:'qtag'},TYPE[q.type]),el('span',{class:'qpts'},q.pts+' poin')),
    el('p',{class:'qprompt'},'Soal '+n+'. '+q.prompt),body);
  function build(){
    body.replaceChildren();
    BUILD[q.type](q,body,function(ok,why){
      state[q.id]={ok:ok};
      body.append(el('div',{class:'fb '+(ok?'ok':'bad'),role:'status'},el('strong',{},ok?'Benar, +'+q.pts+' poin':'Belum tepat'),el('span',{},why)));
      body.append(el('button',{class:'ghost',type:'button',onclick:function(){delete state[q.id];build();updateScore();}},'Ulangi soal'));
      updateScore();
    });
  }
  build();
  return art;
}

