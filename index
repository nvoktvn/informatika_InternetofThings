    wrap.append(el('div',{class:'bosstotal'},el('span',{class:'big',id:'bossTotal'},'0'),el('span',{class:'mono'},'/ 100'),el('span',{class:'pill',id:'bossHp'},'Kekuatan GLITCH tersisa: 100 dari 100')));
    wrap.append(el('p',{style:'color:var(--muted);font-size:.92rem;max-width:64ch'},'Skor tiap kriteria diberikan bertingkat: penuh, sebagian (sekitar setengah), atau minim (sekitar seperempat) sesuai kelengkapan jawaban. Isi kolom skor tim untuk melihat apakah tim lulus.'));
    var ideal=el('details',{class:'ideal'},el('summary',{},'Contoh jawaban ideal untuk guru'),
      el('ul',{},
        el('li',{},el('strong',{},'Celah: '),'(1) kata sandi bawaan pada kamera dan perangkat, berdampak pada akses tidak sah lewat jaringan; (2) data tidak dienkripsi, berdampak pada kebocoran data kesehatan di cloud; (3) firmware tidak diperbarui, berdampak pada kerentanan yang dimanfaatkan hingga mengendalikan aktuator pompa.'),
        el('li',{},el('strong',{},'Prioritas: '),'(1) isolasi dan matikan akses perangkat terinfeksi serta kendalikan pompa secara manual untuk menjamin air bersih; (2) ganti seluruh kata sandi dan perbarui firmware; (3) aktifkan enkripsi dan pantau anomali. Alasannya: keselamatan layanan dasar warga lebih dulu, lalu menutup celah, lalu pencegahan.'),
        el('li',{},el('strong',{},'Solusi: '),'enkripsi data saat dikirim dan disimpan, autentikasi dua faktor untuk dasbor, segmentasi jaringan, pembaruan firmware berkala, deteksi anomali berbasis AI, dan edge computing agar pompa punya batas aman lokal.'),
