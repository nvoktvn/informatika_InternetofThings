function updateScore(){
  var total=0,pulih=0;
  zones.forEach(function(z){
    var pts=0,good=0,ans=0,passed=false,status;
    if(z.boss){
      pts=bossVals.reduce(function(a,b){return a+b;},0);
      ans=bossFilled?1:0;
      passed=bossFilled&&pts>=70;
      status=passed?'Zona pulih':(bossFilled?'Belum mencapai 70':'Belum dinilai');
    }else{
      z.groups.forEach(function(g){g.qs.forEach(function(q){
        var s=state[q.id];
        if(s){ans++;if(s.ok){good++;pts+=q.pts;}}
      });});
      passed=good>=z.pass;
      status=passed?'Zona pulih':(ans===z.count?'Belum lulus: Jalur Perbaikan':'Dijawab '+ans+' dari '+z.count);
    }
    total+=pts; if(passed) pulih++;
    var zp=$('zp-'+z.id); if(zp){zp.textContent=status;zp.className='pill'+(passed?' good':((z.boss?bossFilled:ans===z.count)?' warn':''));}
    var zpts=$('zpts-'+z.id); if(zpts) zpts.textContent=pts+' / '+z.max+' poin';
    var bd=$('bd-'+z.id); if(bd) bd.className='badge'+(passed?' got':'');
    var mc=$('mc-'+z.id); if(mc) mc.className='mc'+(passed?' pulih':'');
    var ms=$('ms-'+z.id); if(ms) ms.textContent=passed?'Pulih · '+pts+' poin':status;
    var nd=$('nd-'+z.id); if(nd) nd.setAttribute('class','node'+(z.boss?' boss':'')+(passed?' lit':''));
  });
  $('totalPts').textContent='Poin '+total+' / '+MAX;
  $('cityStatus').textContent=pulih===4?'Kota pulih sepenuhnya':pulih+' dari 4 zona pulih';
}

