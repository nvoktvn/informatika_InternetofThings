BUILD.pgk=function(q,body,finish){
  var list=el('div',{class:'opts'}), boxes=[];
  q.options.forEach(function(o,i){
    var cb=el('input',{type:'checkbox',id:q.id+'-'+i});
    boxes.push(cb);
    list.append(el('label',{class:'opt chk','for':q.id+'-'+i},cb,el('span',{class:'k'},L[i]),el('span',{},o)));
  });
  var btn=el('button',{class:'primary',type:'button'},'Periksa jawaban');
  btn.addEventListener('click',function(){
    var sel=[];boxes.forEach(function(b,i){if(b.checked)sel.push(i);});
    var ok=sel.length===q.answer.length&&sel.every(function(i){return q.answer.indexOf(i)>=0;});
    boxes.forEach(function(b,i){
      b.disabled=true;
      var lab=b.parentNode;
      if(q.answer.indexOf(i)>=0) lab.classList.add('ok'); else if(b.checked) lab.classList.add('bad');
    });
    btn.remove();
    finish(ok, ok?q.why:'Kunci: '+q.answer.map(function(i){return L[i];}).join(', ')+'. '+q.why);
  });
  body.append(list,btn);
};
