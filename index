<style>
/* Konsep: peta kota sebagai papan sirkuit. Empat zona adalah empat simpul yang menyala saat dipulihkan. */
:root{
  --bg:#F2F6F4; --surface:#FFFFFF; --surface2:#E6EEEB; --fg:#13262B; --muted:#4D666E; --line:#CBD9D4;
  --teal:#0B6E6A; --teal-ink:#FFFFFF; --teal-soft:#D8EEEA;
  --accent:#C2410C; --accent-ink:#FFFFFF; --accent-soft:#FCE6DA;
  --ok:#1B7F4B; --ok-soft:#DCF2E5; --bad:#B42318; --bad-soft:#FBE2DF;
  --trace:#C2D3CD; --trace2:#7FA39A;
  --f-display:'Bricolage Grotesque',system-ui,sans-serif;
  --f-body:'IBM Plex Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --f-mono:'IBM Plex Mono',ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0E181B; --surface:#152227; --surface2:#1C2D33; --fg:#E4EEEC; --muted:#9DB4B8; --line:#2B4047;
    --teal:#4CC2B6; --teal-ink:#06201E; --teal-soft:#16353A;
    --accent:#FF8A50; --accent-ink:#2A1005; --accent-soft:#3A2418;
    --ok:#5CD08F; --ok-soft:#14301F; --bad:#FF8479; --bad-soft:#3A1A17;
    --trace:#243A40; --trace2:#4A7A78; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0E181B; --surface:#152227; --surface2:#1C2D33; --fg:#E4EEEC; --muted:#9DB4B8; --line:#2B4047;
  --teal:#4CC2B6; --teal-ink:#06201E; --teal-soft:#16353A;
  --accent:#FF8A50; --accent-ink:#2A1005; --accent-soft:#3A2418;
  --ok:#5CD08F; --ok-soft:#14301F; --bad:#FF8479; --bad-soft:#3A1A17;
  --trace:#243A40; --trace2:#4A7A78; color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(70px + env(safe-area-inset-top,0px))}
body{background:var(--bg);color:var(--fg);font-family:var(--f-body);font-size:16px;line-height:1.6}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;line-height:1.12;margin:0}
p{margin:0}
a{color:var(--teal)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mono{font-family:var(--f-mono)}
.eyebrow{font-family:var(--f-mono);font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

/* Navigasi */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--surface);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;gap:8px 20px;flex-wrap:wrap;padding-block:10px}
.brand{font-family:var(--f-display);font-weight:800;font-size:1.15rem;text-decoration:none;color:var(--fg)}
.brand b{color:var(--teal)}
.links{display:flex;gap:4px;overflow-x:auto;min-width:0;flex:1 1 320px;scrollbar-width:none}
.links::-webkit-scrollbar{display:none}
.links a{white-space:nowrap;text-decoration:none;color:var(--muted);font-size:.9rem;font-weight:500;padding:6px 10px;border-radius:6px}
.links a:hover{background:var(--surface2);color:var(--fg)}
.chip{font-family:var(--f-mono);font-size:.82rem;background:var(--teal-soft);color:var(--fg);padding:5px 10px;border-radius:999px;white-space:nowrap}

/* Hero */
.hero{border-bottom:1px solid var(--line)}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:36px;align-items:center;padding-block:52px 44px}
@media (max-width:820px){.hero .wrap{grid-template-columns:1fr;padding-block:32px}}
.hero h1{font-size:clamp(3rem,9vw,5.2rem);font-weight:800;letter-spacing:-.02em;margin:10px 0 6px}
.hero h1 span{color:var(--teal)}
.hero .sub{font-family:var(--f-display);font-size:clamp(1.15rem,2.6vw,1.45rem);font-weight:500;color:var(--fg);margin-bottom:18px}
.hero .story{max-width:56ch;color:var(--muted);display:grid;gap:12px}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
.meta span{font-family:var(--f-mono);font-size:.8rem;border:1px solid var(--line);background:var(--surface);padding:4px 10px;border-radius:999px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;min-width:0}
.panel .readout{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-family:var(--f-mono);font-size:.78rem;color:var(--muted);margin-bottom:6px}
.panel .readout b{color:var(--fg);font-weight:500}
.circuit{width:100%;height:auto;display:block}
.circuit .tr{fill:none;stroke:var(--trace2);stroke-width:3;stroke-linejoin:round}
.circuit .tr2{fill:none;stroke:var(--trace);stroke-width:2}
.circuit .dot{fill:var(--trace2)}
.circuit .node circle{fill:var(--surface);stroke:var(--trace2);stroke-width:3;transition:fill .3s}
.circuit .node .n{font-family:var(--f-mono);font-size:13px;font-weight:500;fill:var(--fg);text-anchor:middle}
.circuit .node .nm{font-family:var(--f-body);font-size:11.5px;fill:var(--muted);text-anchor:middle}
.circuit .node.lit circle{fill:var(--teal);stroke:var(--teal)}
.circuit .node.lit .n{fill:var(--teal-ink)}
.circuit .node.boss.lit circle{fill:var(--accent);stroke:var(--accent)}
.circuit .node.boss.lit .n{fill:var(--accent-ink)}

/* Seksi umum */
section.block{padding-block:56px;border-bottom:1px solid var(--line)}
.sec-head{display:grid;gap:8px;margin-bottom:28px;max-width:62ch}
.sec-head h2{font-size:clamp(1.7rem,4vw,2.4rem)}
.sec-head p{color:var(--muted)}

/* Peta */
.mapgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;list-style:none;margin:0;padding:0;position:relative}
@media (max-width:900px){.mapgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.mapgrid{grid-template-columns:1fr}}
.mc{display:flex;flex-direction:column;gap:10px;text-decoration:none;color:var(--fg);background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px;height:100%;transition:border-color .2s,transform .2s}
.mc:hover{border-color:var(--teal);transform:translateY(-2px)}
.mc .zn{font-family:var(--f-mono);font-size:.78rem;letter-spacing:.1em;color:var(--muted);display:flex;justify-content:space-between;gap:8px}
.mc h3{font-size:1.3rem}
.mc .fo{color:var(--muted);font-size:.92rem;flex:1}
.mc dl{margin:0;display:grid;gap:4px;font-size:.84rem}
.mc dl div{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line);padding-top:4px}
.mc dt{color:var(--muted)}
.mc dd{margin:0;text-align:right;font-weight:500}
.mc .st{font-family:var(--f-mono);font-size:.76rem;color:var(--muted)}
.mc.pulih{border-color:var(--teal);background:var(--teal-soft)}
.mc.pulih .st{color:var(--fg)}
.maptime{margin-top:18px;font-size:.92rem;color:var(--muted)}

/* Zona */
.zhead{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 16px;margin-bottom:6px}
.zno{font-family:var(--f-mono);font-size:.85rem;letter-spacing:.14em;color:var(--teal);font-weight:500}
.zhead h2{font-size:clamp(1.9rem,5vw,2.9rem);font-weight:800}
.ztime{font-family:var(--f-mono);font-size:.8rem;background:var(--surface2);padding:3px 10px;border-radius:999px}
.zintro{max-width:64ch;color:var(--muted);margin:10px 0 18px}
.zsum{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;margin-bottom:26px}
.pill{font-family:var(--f-mono);font-size:.78rem;padding:4px 10px;border-radius:999px;background:var(--surface2);color:var(--fg)}
.pill.good{background:var(--ok-soft);color:var(--fg);border:1px solid var(--ok)}
.pill.warn{background:var(--accent-soft);color:var(--fg);border:1px solid var(--accent)}
.badge{font-size:.82rem;font-weight:600;padding:4px 12px;border-radius:999px;border:1px dashed var(--trace2);color:var(--muted)}
.badge.got{border:1px solid var(--teal);background:var(--teal);color:var(--teal-ink)}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 32px;margin:0 0 34px}
@media (max-width:700px){.facts{grid-template-columns:1fr}}
.facts div{border-top:2px solid var(--line);padding-top:10px}
.facts dt{font-family:var(--f-mono);font-size:.76rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.facts dd{margin:0}
.qgroup{max-width:760px;margin-bottom:34px}
.qgroup>h3{font-size:1.35rem;margin-bottom:4px}
.qgroup>.note{color:var(--muted);font-size:.92rem;margin-bottom:14px}
.q{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:14px}
.qhead{display:flex;justify-content:space-between;gap:10px;margin-bottom:8px}
.qtag{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.qpts{font-family:var(--f-mono);font-size:.76rem;color:var(--teal);font-weight:500}
.qprompt{margin-bottom:14px;font-weight:500}
.qprompt small{display:block;font-weight:400;color:var(--muted);margin-top:4px}
.opts{display:grid;gap:8px;margin-bottom:6px}
.opt{display:flex;gap:12px;align-items:flex-start;text-align:left;width:100%;font:inherit;color:var(--fg);background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px;cursor:pointer;transition:border-color .15s,background .15s}
.opt:hover:not(:disabled){border-color:var(--teal);background:var(--surface2)}
.opt:disabled{cursor:default}
.opt .k{flex:none;width:26px;height:26px;display:grid;place-items:center;border:1px solid var(--trace2);border-radius:6px;font-family:var(--f-mono);font-size:.8rem}
.opt.chk input{position:absolute;opacity:0;pointer-events:none}
.opt.chk:has(input:checked){border-color:var(--teal);background:var(--teal-soft)}
.opt.chk:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}
.opt.ok{border-color:var(--ok);background:var(--ok-soft)!important}
.opt.bad{border-color:var(--bad);background:var(--bad-soft)!important}
.bsrow{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.bsrow .opt{justify-content:center;font-weight:600}
.primary,.ghost{font:inherit;font-weight:600;border-radius:8px;padding:9px 16px;cursor:pointer;border:1px solid var(--teal)}
.primary{background:var(--teal);color:var(--teal-ink);margin-top:8px}
.primary:disabled{opacity:.45;cursor:not-allowed}
.ghost{background:transparent;color:var(--teal);margin-top:10px;font-weight:500;font-size:.88rem;padding:6px 12px}
.fb{margin-top:12px;padding:12px 14px;border-radius:8px;display:grid;gap:4px;font-size:.94rem}
.fb strong{font-family:var(--f-display)}
.fb.ok{background:var(--ok-soft);border:1px solid var(--ok)}
.fb.bad{background:var(--bad-soft);border:1px solid var(--bad)}
/* drag and drop */
.pool,.slot{display:flex;flex-wrap:wrap;gap:8px;align-content:flex-start}
.pool{min-height:52px;padding:10px;border:1px dashed var(--trace2);border-radius:10px;margin-bottom:12px;background:var(--surface2)}
.pool:empty::after{content:"Semua kartu sudah ditempatkan";color:var(--muted);font-size:.86rem}
.bins{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.bin{border:1px solid var(--line);border-radius:10px;padding:10px;min-height:96px;min-width:0;background:var(--surface);transition:border-color .15s,background .15s}
.bin.over{border-color:var(--teal);background:var(--teal-soft)}
.binname{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;color:var(--teal);margin-bottom:8px;font-weight:500}
.dcard{font:inherit;font-size:.9rem;text-align:left;color:var(--fg);background:var(--surface);border:1px solid var(--trace2);border-radius:8px;padding:6px 10px;cursor:grab;max-width:100%}
.dcard.sel{border-color:var(--accent);background:var(--accent-soft);box-shadow:0 0 0 2px var(--accent)}
.dcard.ok{border-color:var(--ok);background:var(--ok-soft)}
.dcard.bad{border-color:var(--bad);background:var(--bad-soft)}
.dcard:disabled{cursor:default}
/* menjodohkan */
.mrow{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:8px 12px;align-items:center;padding:8px;border-radius:8px;border:1px solid transparent}
@media (max-width:560px){.mrow{grid-template-columns:1fr}}
.mrow .term{font-family:var(--f-mono);font-weight:500}
.mrow select{font:inherit;color:var(--fg);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:8px;min-width:0;width:100%}
.mrow.ok{background:var(--ok-soft);border-color:var(--ok)}
.mrow.bad{background:var(--bad-soft);border-color:var(--bad)}
/* mengurutkan */
.ord{list-style:none;margin:0 0 6px;padding:0;display:grid;gap:8px;counter-reset:o}
.oitem{counter-increment:o;display:flex;gap:10px;align-items:center;border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:var(--surface)}
.oitem::before{content:counter(o);flex:none;width:24px;height:24px;display:grid;place-items:center;font-family:var(--f-mono);font-size:.78rem;border-radius:50%;background:var(--surface2)}
.oitem .ot{flex:1;min-width:0}
.oitem .ob{display:flex;gap:4px}
.oitem .ob button{font:inherit;width:34px;height:34px;border-radius:6px;border:1px solid var(--line);background:var(--surface);color:var(--fg);cursor:pointer}
.oitem .ob button:hover:not(:disabled){border-color:var(--teal)}
.oitem .ob button:disabled{opacity:.35;cursor:default}
.oitem.ok{background:var(--ok-soft);border-color:var(--ok)}
.oitem.bad{background:var(--bad-soft);border-color:var(--bad)}

/* Boss */
.case{background:var(--surface2);border:1px solid var(--line);border-radius:12px;padding:20px;max-width:760px;margin-bottom:22px}
.case .eyebrow{display:block;margin-bottom:8px;color:var(--accent);font-weight:500}
.sub3{display:grid;gap:12px;max-width:760px;margin:0 0 28px;padding:0;list-style:none}
.sub3 li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 14px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
.sub3 .lv{font-family:var(--f-mono);font-size:.8rem;font-weight:500;background:var(--accent);color:var(--accent-ink);border-radius:6px;padding:2px 8px;height:fit-content}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:.94rem}
th,td{text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;background:var(--surface2)}
tr:last-child td{border-bottom:0}
td.num{font-family:var(--f-mono);white-space:nowrap}
.rb-in{font:inherit;font-family:var(--f-mono);width:76px;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--fg)}
.bosstotal{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin:14px 0 6px}
.bosstotal .big{font-family:var(--f-display);font-size:2rem;font-weight:800}
details.ideal{margin-top:22px;max-width:760px;border:1px solid var(--line);border-radius:12px;background:var(--surface);padding:4px 16px}
details.ideal summary{cursor:pointer;font-weight:600;padding:12px 0}
details.ideal ul{padding-left:20px;display:grid;gap:8px;margin:0 0 14px}

/* Guru */
.timeline{display:flex;height:18px;border-radius:9px;overflow:hidden;gap:2px;margin:6px 0 14px}
.timeline i{display:block;background:var(--c,var(--teal))}
.tl-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px 24px;list-style:none;margin:0 0 34px;padding:0}
.tl-list li{display:grid;gap:2px;font-size:.92rem}
.tl-list b{font-family:var(--f-mono);font-size:.8rem;display:flex;align-items:center;gap:8px}
.tl-list b::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--c,var(--teal))}
.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}
@media (max-width:760px){.two{grid-template-columns:1fr}}
.defs{margin:0;display:grid;gap:14px}
.defs div{border-top:2px solid var(--line);padding-top:8px}
.defs dt{font-weight:600;margin-bottom:2px}
.defs dd{margin:0;color:var(--muted)}
.h3s{font-size:1.4rem;margin-bottom:14px}
footer{padding-block:32px;color:var(--muted);font-size:.86rem}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>

